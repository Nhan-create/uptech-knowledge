{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/apply-safe-google-access-states.mjs && node scripts/generate-mobile-association-artifacts.mjs && node scripts/production-deploy-contract.mjs",
    "migrate:login:production": "node scripts/apply-safe-google-access-states.mjs",
    "generate:mobile-associations": "node scripts/generate-mobile-association-artifacts.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:security": "node --experimental-strip-types --test src/security/route-containment.test.mjs src/server/**/*.test.ts src/worker/**/*.test.ts && node --experimental-strip-types --experimental-loader ./test/next-alias-loader.mjs --test test/google-directory-cron-route.test.ts && node --test test/domain-fixture-safety.test.mjs",
    "test:login-routes": "node --experimental-strip-types --experimental-test-module-mocks --experimental-loader ./test/next-alias-loader.mjs --test test/google-login-route-safety.test.ts test/web-session-bootstrap-route.test.ts",
    "test:login-ui": "node --test test/login-ui.test.mjs test/login-auth-safety.test.mjs",
    "test:browser:bootstrap": "node scripts/run-google-workspace-bootstrap-browser.mjs",
    "test:postgres": "node --experimental-strip-types --test test/integration/phase1-postgres.test.ts",
    "test:postgres:a1": "node --experimental-strip-types --test test/integration/google-auth-a1-postgres.test.ts",
    "test:postgres:a3": "node --experimental-strip-types --test test/integration/mobile-auth-a3-postgres.test.ts",
    "test:postgres:enterprise": "node --experimental-strip-types --test test/integration/enterprise-login-postgres.test.ts",
    "test:postgres:bootstrap": "node --experimental-strip-types --test test/integration/google-workspace-bootstrap-postgres.test.ts test/integration/bootstrap-migration-runner-postgres.test.ts",
    "test:deploy-contract": "node --test test/production-deploy-contract.test.mjs test/mobile-google-registry-deploy-contract.test.mjs test/safe-google-access-states-deploy-contract.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.0",
    "@vercel/oidc": "^3.8.5",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "openid-client": "6.8.7",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
