# Server-only Resend configuration. Replace every placeholder locally or in Vercel.
RESEND_API_KEY=re_replace_with_your_api_key
DEMO_LEAD_FROM_EMAIL=UPTECH KNOWLEDGE <demo@your-verified-domain.example>

# Production Google Workspace login (all values are server-only).
PRODUCTION_BASE_URL=https://knowledge.example.com
GOOGLE_REDIRECT_URI=https://knowledge.example.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_web_client_secret
GOOGLE_WORKSPACE_DOMAIN=example.com
DATABASE_URL=postgresql://runtime_role:replace@database.example.com:5432/uptech?sslmode=require
UPTECH_ENVIRONMENT_ID=production
UPTECH_ENVIRONMENT_RATE_KEY=replace_with_43_character_base64url_key
UPTECH_GOOGLE_LOGIN_PKCE_KEY=replace_with_43_character_base64url_key
UPTECH_GOOGLE_LOGIN_PKCE_KEY_VERSION=replace_with_kms_key_version
UPTECH_SESSION_PEPPER=replace_with_43_character_base64url_key

# Server-only mobile public-client adapter. Callback and app-return URLs are
# fixed in the approved A3 registry and are intentionally not configurable.
GOOGLE_MOBILE_CLIENT_ID=replace_with_google_mobile_backend_web_client_id
GOOGLE_MOBILE_CLIENT_SECRET=replace_with_google_mobile_backend_web_client_secret
UPTECH_MOBILE_REFRESH_REPLAY_KEY=replace_with_43_character_base64url_key
