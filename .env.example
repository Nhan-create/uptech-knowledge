# Server-only Resend configuration. Replace every placeholder locally or in Vercel.
RESEND_API_KEY=re_replace_with_your_api_key
DEMO_LEAD_FROM_EMAIL=UPTECH KNOWLEDGE <demo@your-verified-domain.example>

# Production Google Workspace login (all values are server-only).
PRODUCTION_BASE_URL=https://knowledge.example.com
GOOGLE_REDIRECT_URI=https://knowledge.example.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=replace_with_google_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_web_client_secret
DATABASE_URL=postgresql://runtime_role:replace@database.example.com:5432/uptech?sslmode=require
UPTECH_ENVIRONMENT_ID=production
UPTECH_ENVIRONMENT_RATE_KEY=replace_with_43_character_base64url_key
UPTECH_GOOGLE_LOGIN_PKCE_KEY=replace_with_43_character_base64url_key
UPTECH_GOOGLE_LOGIN_PKCE_KEY_VERSION=replace_with_kms_key_version
UPTECH_SESSION_PEPPER=replace_with_43_character_base64url_key

# Google Workspace Directory: server-only, keyless Vercel OIDC -> GCP WIF.
# Register https://uptech-knowledge-sigma.vercel.app/api/v1/admin/connectors/google-directory/callback
# as an additional redirect URI on the existing Google OAuth Web client.
UPTECH_GCP_SECRET_MANAGER_PROJECT_ID=replace-with-gcp-project-id
UPTECH_GCP_WORKLOAD_IDENTITY_PROVIDER=https://iam.googleapis.com/projects/123456789/locations/global/workloadIdentityPools/vercel/providers/vercel
UPTECH_GCP_SECRET_MANAGER_SERVICE_ACCOUNT_EMAIL=directory-runtime@replace-with-gcp-project-id.iam.gserviceaccount.com
CRON_SECRET=replace_with_a_random_32_to_256_character_server_secret

# Optional server-only mobile OAuth override. If omitted, the mobile adapter
# reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET. Callback and app-return URLs
# remain fixed in the approved A3 registry and are never client-controlled.
GOOGLE_MOBILE_CLIENT_ID=replace_with_google_mobile_backend_web_client_id
GOOGLE_MOBILE_CLIENT_SECRET=replace_with_google_mobile_backend_web_client_secret
UPTECH_MOBILE_REFRESH_REPLAY_KEY=replace_with_43_character_base64url_key

# Non-secret release association metadata. Vercel production builds generate
# the Android assetlinks file from this exact uppercase SHA-256 fingerprint.
UPTECH_ANDROID_APP_LINKS_SHA256=replace_with_uppercase_colon_separated_sha256_fingerprint
# Enable iOS only after the release signing Team ID has been verified. A
# placeholder association is never accepted.
UPTECH_IOS_UNIVERSAL_LINKS_ENABLED=false
# UPTECH_IOS_TEAM_ID=YOUR10CHAR
